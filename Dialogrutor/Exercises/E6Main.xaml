<Window x:Class="Dialogrutor.Exercises.E6Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dialogrutor.Exercises"
        mc:Ignorable="d"
        Title="E6" Height="450" Width="800">
    
    <!--Note to future me, bindings är redundanta så som jag har löst denna övningen-->
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal" >
            <Rectangle Fill="{Binding Source={StaticResource Color1}}" Height="75" Width="75"
                       RadiusX="5"
                       RadiusY="5"
                       Margin="5"
                       MouseLeftButtonDown="Button_Click"/>
            <Rectangle Fill="{Binding Source={StaticResource Color1}}" Height="75" Width="75"
                       RadiusX="5"
                       RadiusY="5"
                       Margin="5"
                       MouseLeftButtonDown="Button_Click"/>
            <Rectangle Fill="{Binding Source={StaticResource Color1}}" Height="75" Width="75"
                       RadiusX="5"
                       RadiusY="5"
                       Margin="5"
                       MouseLeftButtonDown="Button_Click"/>
            <Rectangle Fill="{Binding Source={StaticResource Color1}}" Height="75" Width="75"
                       RadiusX="5"
                       RadiusY="5"
                       Margin="5"
                       MouseLeftButtonDown="Button_Click"/>
        </StackPanel>
        
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal" >
            <Rectangle Fill="{Binding Source={StaticResource Color1}}" Height="75" Width="75"
                       RadiusX="5"
                       RadiusY="5"
                       Margin="5"
                       MouseLeftButtonDown="Button_Click"/>
            <Rectangle Fill="{Binding Source={StaticResource Color1}}" Height="75" Width="75"
                       RadiusX="5"
                       RadiusY="5"
                       Margin="5"
                       MouseLeftButtonDown="Button_Click"/>
            <Rectangle Fill="{Binding Source={StaticResource Color1}}" Height="75" Width="75"
                       RadiusX="5"
                       RadiusY="5"
                       Margin="5"
                       MouseLeftButtonDown="Button_Click"/>
            <Rectangle Fill="{Binding Source={StaticResource Color1}}" Height="75" Width="75"
                       RadiusX="5"
                       RadiusY="5"
                       Margin="5"
                       MouseLeftButtonDown="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
